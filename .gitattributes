# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source code & configs always use LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.java text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf

# Windows specific scripts
*.cmd text eol=crlf
*.bat text eol=crlf
