# API 서버 주소(origin)만 넣는다. /api prefix는 백엔드 경로(스펙)에 포함돼 있다.
# 로컬은 비워 두고 Vite proxy가 /api 요청을 VITE_PROXY_TARGET으로 넘긴다.
VITE_API_BASE_URL=
# 로컬 개발 서버 proxy 대상 백엔드 주소
VITE_PROXY_TARGET=http://localhost:8080
# pnpm oag:generate가 스펙을 받는 주소 (springdoc 기본 경로)
OPENAPI_SPEC_URL=http://localhost:8080/v3/api-docs
# PortOne 결제창 식별값(브라우저에 노출되는 공개 값). 백엔드 portone.store-id·channel-key와 같아야 한다
VITE_PORTONE_STORE_ID=store-e0d4f767-f9dd-4a26-b211-43eec5270bc2
VITE_PORTONE_CHANNEL_KEY=channel-key-c2b525f3-ef4b-475f-868f-8728605ff965
