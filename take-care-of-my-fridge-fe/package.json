    "oag:generate:offline": "sh scripts/oag-generate.sh --offline"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@portone/browser-sdk": "^0.1.13",
    "@tanstack/react-query": "5.104.3",
    "antd": "6.6.6",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "sass": "1.105.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
