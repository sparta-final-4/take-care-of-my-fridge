DELETE http://localhost:8080/api/fridge/items/{{cookingFridgeId}}?reason=WRONG_ENTRY
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

> {%
    client.test("테스트용 재료 정리 성공", () => {
