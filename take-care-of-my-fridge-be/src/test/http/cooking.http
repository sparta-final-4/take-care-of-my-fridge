// 요리 기록은 삭제 API가 별도로 제공되지 않아 테스트를 실행할 때마다 이력이 하나씩 누적됩니다.

### 1. 로그인
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "cookie@naver.com",
  "password": "rkddkwlrnldudnj1!"
}

> {%
    client.test("로그인 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
    });

    const setCookie = response.headers.valueOf("Set-Cookie");
    if (setCookie) {
        const match = /access_token=([^;]+)/.exec(setCookie);
        if (match) {
            client.global.set("accessToken", match[1]);
            client.log("accessToken 저장 완료");
        }
    }
%}

### 2. CSRF 토큰 발급
GET http://localhost:8080/api/auth/csrf
Cookie: access_token={{accessToken}}

> {%
    client.test("CSRF 토큰 발급 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
    });
    client.global.set("csrfToken", response.body.data.token);
    client.log("CSRF 토큰 저장 완료: " + response.body.data.token);
%}

### 3. 레시피 목록 조회 (첫 번째 레시피 ID 추출)
GET http://localhost:8080/api/recipes?size=1
Cookie: access_token={{accessToken}}

> {%
    client.test("레시피 목록 조회 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        client.assert(response.body.data.content.length > 0, "레시피가 1개 이상 존재해야 합니다.");
    });

    if (response.body && response.body.data && response.body.data.content && response.body.data.content.length > 0) {
        client.global.set("recipeId", response.body.data.content[0].recipeId);
        client.log("선택된 레시피 ID: " + response.body.data.content[0].recipeId);
    }
%}

### 4. 차감 테스트용 냉장고 재료 등록 (양파 3개)
POST http://localhost:8080/api/fridge/items
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "items": [
    {
      "rawName": "양파",
      "quantity": 3,
      "storage": "REFRIGERATED",
      "expirationDate": "2026-11-30"
    }
  ]
}

> {%
    client.test("차감용 재료 등록 성공", () => {
        client.assert(response.status === 200, "상태 코드 200 실패! 현재: " + response.status + ", 에러: " + (response.body && response.body.error ? response.body.error.message : ""));
        client.assert(response.body && response.body.data && response.body.data.length > 0, "등록된 재료 데이터가 있어야 합니다.");
        client.assert(response.body.data[0].quantity === 3, "초기 등록 수량은 3이어야 합니다.");
    });

    if (response.status === 200 && response.body && response.body.data && response.body.data.length > 0) {
        client.global.set("cookingFridgeId", response.body.data[0].id);
        client.global.set("cookingIngredientId", response.body.data[0].ingredientId);
        client.log("등록된 냉장고 ID: " + response.body.data[0].id + ", 재료 ID: " + response.body.data[0].ingredientId);
    }
%}

### 5. 요리 완료 기록 및 냉장고 재료 1 차감
POST http://localhost:8080/api/cooking-logs
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "recipeId": {{recipeId}},
  "result": "SUCCESS",
  "memo": "맛있게 요리 완료!",
  "usedIngredients": [
    {
      "ingredientId": {{cookingIngredientId}},
      "quantity": 1
    }
  ]
}

> {%
    client.test("요리 완료 성공", () => {
        client.assert(response.status === 200, "상태 코드 200 실패! 현재: " + response.status);
        client.assert(response.body.data.cookingLogId !== null, "cookingLogId가 반환되어야 합니다.");
    });

    if (response.status === 200 && response.body && response.body.data) {
        client.global.set("cookingLogId", response.body.data.cookingLogId);
        client.log("생성된 요리 기록 ID: " + response.body.data.cookingLogId);
    }
%}

### 6. 냉장고 재료 수량 차감 확인 (수량 3 -> 2)
GET http://localhost:8080/api/fridge/items
Cookie: access_token={{accessToken}}

> {%
    client.test("냉장고 재료 차감 확인 (수량 1 차감되어 2)", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        const targetFridgeId = parseInt(client.global.get("cookingFridgeId"));
        const item = response.body.data.find(i => i.id === targetFridgeId);
        client.assert(item !== undefined, "냉장고에 재료가 남아 있어야 합니다.");
        client.assert(item.quantity === 2, "수량이 3에서 2로 줄어들어야 합니다. 현재: " + (item ? item.quantity : "없음"));
    });
%}

### 7. 냉장고 이력에 요리 완료 차감(cookedByRecipe=true) 기록 확인
GET http://localhost:8080/api/fridge/logs?action=CONSUMED
Cookie: access_token={{accessToken}}

> {%
    client.test("냉장고 로그에 요리 완료로 차감된 기록 확인", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        const cookedLog = response.body.data.content.find(log => log.cookedByRecipe === true);
        client.assert(cookedLog !== undefined, "cookedByRecipe가 true인 로그가 존재해야 합니다.");
    });
%}

### 8. 내 요리 기록 목록 조회 (1건 이상 및 방금 요리한 기록 포함 확인)
GET http://localhost:8080/api/cooking-logs?recipeId={{recipeId}}
Cookie: access_token={{accessToken}}

> {%
    client.test("내 요리 기록 조회 확인", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        client.assert(response.body.data.content.length >= 1, "요리 기록이 1건 이상이어야 합니다.");
        const targetLogId = parseInt(client.global.get("cookingLogId"));
        const found = response.body.data.content.some(log => log.id === targetLogId);
        client.assert(found, "방금 등록한 요리 기록이 포함되어 있어야 합니다.");
    });
%}

### 9. 요리 기록 수정 (결과 FAILED 및 메모 변경)
PATCH http://localhost:8080/api/cooking-logs/{{cookingLogId}}
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "result": "FAILED",
  "memo": "불 조절 실패로 살짝 탔어요."
}

> {%
    client.test("요리 기록 수정 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        client.assert(response.body.data.result === "FAILED", "결과가 FAILED로 변경되어야 합니다.");
        client.assert(response.body.data.memo === "불 조절 실패로 살짝 탔어요.", "메모가 변경되어야 합니다.");
    });
%}

### 10-1. 내 레시피 목록 조회 (요리 완료한 레시피 포함 확인)
GET http://localhost:8080/api/me/recipes
Cookie: access_token={{accessToken}}

> {%
    client.test("내 레시피 목록 조회 및 요리한 레시피 포함 확인", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        const targetRecipeId = parseInt(client.global.get("recipeId"));
        const found = response.body.data.recipes.content.some(r => r.recipeId === targetRecipeId);
        client.assert(found, "요리 완료한 레시피가 내 레시피 목록에 포함되어 있어야 합니다.");
    });
%}

### 10-2. 내 레시피 목록 조회 (reviewStatus=NOT_WRITTEN 필터)
GET http://localhost:8080/api/me/recipes?reviewStatus=NOT_WRITTEN
Cookie: access_token={{accessToken}}

> {%
    client.test("후기 미작성 레시피 목록 조회 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
    });
%}

### 11. 레시피 요리 통계 조회 (통계 누적 확인)
GET http://localhost:8080/api/recipes/{{recipeId}}/cooking-stats
Cookie: access_token={{accessToken}}

> {%
    client.test("레시피 요리 통계 확인", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        client.assert(response.body.data.recipeId === parseInt(client.global.get("recipeId")), "레시피 ID가 일치해야 합니다.");
        client.assert(response.body.data.totalCount >= 1, "총 요리 횟수가 1 이상이어야 합니다.");
    });
%}

### 12-1. 실패 검증: 존재하지 않는 레시피로 요리 완료 시 404
POST http://localhost:8080/api/cooking-logs
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "recipeId": 9999999,
  "result": "SUCCESS",
  "memo": "없는 레시피 요리 완료 테스트"
}

> {%
    client.test("없는 레시피 요리 완료 실패 (404)", () => {
        client.assert(response.status === 404, "존재하지 않는 레시피는 404를 반환해야 합니다.");
    });
%}

### 12-2. 실패 검증: 존재하지 않는 요리 기록 수정 시 404
PATCH http://localhost:8080/api/cooking-logs/9999999
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "result": "SUCCESS",
  "memo": "없는 요리 기록 수정 테스트"
}

> {%
    client.test("없는 요리 기록 수정 실패 (404)", () => {
        client.assert(response.status === 404, "존재하지 않는 요리 기록은 404를 반환해야 합니다.");
    });
%}

### 12-3. 실패 검증: 메모 50자 초과(51자) 입력 시 400
PATCH http://localhost:8080/api/cooking-logs/{{cookingLogId}}
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "result": "SUCCESS",
  "memo": "123456789012345678901234567890123456789012345678901"
}

> {%
    client.test("메모 50자 초과 시 400 반환 확인", () => {
        client.assert(response.status === 400, "메모가 50자를 초과하면 400이어야 합니다.");
    });
%}

