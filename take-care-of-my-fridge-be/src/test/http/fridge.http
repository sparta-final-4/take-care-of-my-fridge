### 4. 냉장고 재료 정보 수정 (이름, 수량, 소비기한 변경)
PATCH http://localhost:8080/api/fridge/items/{{fridgeId1}}
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "rawName": "깐양파",
  "quantity": 4,
  "storage": "REFRIGERATED",
  "expirationDate": "2026-11-05"
}

> {%
    client.test("재료 수정 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        client.assert(response.body.data.rawName === "깐양파", "이름이 깐양파로 변경되어야 합니다.");
        client.assert(response.body.data.quantity === 4, "수량이 4로 변경되어야 합니다.");
        client.assert(response.body.data.expirationDate === "2026-11-05", "소비기한이 2026-11-05로 변경되어야 합니다.");
    });
%}

### 5. 재료 빼기: 일부 수량 차감 (남은 수량 확인)
POST http://localhost:8080/api/fridge/items/{{fridgeId1}}/take-out
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "action": "CONSUMED",
  "quantity": 1
}

> {%
    client.test("일부 수량 차감 성공 및 잔여 수량 확인", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        client.assert(response.body.data.removed === false, "일부 차감이므로 삭제되지 않아야 합니다.");
        client.assert(response.body.data.remainingQuantity === 3, "남은 수량이 3이어야 합니다.");
    });
%}

### 6-1. 재료 빼기: 수량 비워서 전부 차감 (삭제 처리)
POST http://localhost:8080/api/fridge/items/{{fridgeId1}}/take-out
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "action": "CONSUMED"
}

> {%
    client.test("전부 차감 및 삭제 처리 확인", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        client.assert(response.body.data.removed === true, "전부 뺐으므로 removed가 true여야 합니다.");
        client.assert(response.body.data.remainingQuantity === 0, "남은 수량이 0이어야 합니다.");
    });
%}

### 6-2. 목록에서 완전히 삭제되었는지 조회 확인
GET http://localhost:8080/api/fridge/items
Cookie: access_token={{accessToken}}

> {%
    client.test("전부 뺀 재료가 목록에서 사라졌는지 확인", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        const targetId = parseInt(client.global.get("fridgeId1"));
        const exists = response.body.data.some(item => item.id === targetId);
        client.assert(!exists, "차감 완료된 재료는 목록에 존재하지 않아야 합니다.");
    });
%}

