### 1. 로그인
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "cookie@naver.com",
  "password": "rkddkwlrnldudnj1!"
}

> {%
    client.test("로그인 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
    });

    const setCookie = response.headers.valueOf("Set-Cookie");
    if (setCookie) {
        const match = /access_token=([^;]+)/.exec(setCookie);
        if (match) {
            client.global.set("accessToken", match[1]);
            client.log("accessToken 저장 완료");
        }
    }
%}

### 2. CSRF 토큰 발급
GET http://localhost:8080/api/auth/csrf
Cookie: access_token={{accessToken}}

> {%
    client.test("CSRF 토큰 발급 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
    });
    client.global.set("csrfToken", response.body.data.token);
    client.log("CSRF 토큰 저장 완료: " + response.body.data.token);
%}

### 3-1. 냉장고 재료 일괄 등록 (사전 재료 3개 + 사전 미등재 1개, 기본값 적용 1개)
POST http://localhost:8080/api/fridge/items
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "items": [
    {
      "rawName": "양파",
      "quantity": 5
    },
    {
      "rawName": "두부",
      "quantity": 2,
      "storage": "REFRIGERATED",
      "expirationDate": "2026-10-30"
    },
    {
      "rawName": "대파",
      "quantity": 3,
      "storage": "REFRIGERATED",
      "expirationDate": "2026-10-25"
    },
    {
      "rawName": "특수우주버섯XYZ",
      "quantity": 1,
      "storage": "ROOM_TEMP",
      "expirationDate": "2026-11-01"
    }
  ]
}

> {%
    client.test("등록 성공 및 기본값/매핑 확인", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다. 현재: " + response.status);
        client.assert(response.body && response.body.data && response.body.data.length === 4, "4개 항목이 등록되어야 합니다.");

        // 비운 보관 방법·소비기한이 사전 기본값으로 채워졌는지 확인 (양파)
        const defaultItem = response.body.data[0];
        client.assert(defaultItem.storage !== null && defaultItem.storage !== undefined, "보관방법 기본값이 채워져야 합니다.");
        client.assert(defaultItem.expirationDate !== null && defaultItem.expirationDate !== undefined, "소비기한 기본값이 채워져야 합니다.");

        // 사전에 없는 재료가 기타(ING_CUSTOM)로 매핑됐는지 확인
        const customItem = response.body.data[3];
        client.assert(customItem.ingredientName === "기타", "사전에 없는 재료의 표준 재료명은 '기타'여야 합니다.");
    });

    if (response.status === 200 && response.body && response.body.data && response.body.data.length >= 4) {
        client.global.set("fridgeId1", response.body.data[0].id);
        client.global.set("fridgeId2", response.body.data[1].id);
        client.global.set("fridgeId3", response.body.data[2].id);
        client.global.set("fridgeIdCustom", response.body.data[3].id);
    }
%}

### 3-2. 냉장고 재료 목록 조회 (기본)
GET http://localhost:8080/api/fridge/items
Cookie: access_token={{accessToken}}

> {%
    client.test("기본 목록 조회 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        client.assert(response.body.data.length >= 4, "등록한 재료를 포함해 목록이 조회되어야 합니다.");
    });
%}

### 3-3. 냉장고 재료 목록 조회 (보관 방식 필터: 냉장)
GET http://localhost:8080/api/fridge/items?storage=REFRIGERATED
Cookie: access_token={{accessToken}}

> {%
    client.test("냉장 목록 조회 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        const allRefrigerated = response.body.data.every(item => item.storage === "REFRIGERATED");
        client.assert(allRefrigerated, "조회된 모든 재료의 보관 방식이 REFRIGERATED여야 합니다.");
    });
%}

