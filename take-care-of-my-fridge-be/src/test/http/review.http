// 요리 기록은 삭제 API가 없어서 실행할 때마다 쌓임

### 1. 로그인
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "cookie@naver.com",
  "password": "rkddkwlrnldudnj1!"
}

> {%
    client.test("로그인 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
    });

    const setCookie = response.headers.valueOf("Set-Cookie");
    if (setCookie) {
        const match = /access_token=([^;]+)/.exec(setCookie);
        if (match) {
            client.global.set("accessToken", match[1]);
            client.log("accessToken 저장 완료");
        }
    }
%}

### 2. CSRF 토큰 발급
GET http://localhost:8080/api/auth/csrf
Cookie: access_token={{accessToken}}

> {%
    client.test("CSRF 토큰 발급 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
    });
    client.global.set("csrfToken", response.body.data.token);
    client.log("CSRF 토큰 저장 완료: " + response.body.data.token);
%}

### 3. 레시피 목록 조회 (후기 작성용 recipeId 및 미요리 테스트용 uncookedRecipeId 추출)
GET http://localhost:8080/api/recipes?size=5
Cookie: access_token={{accessToken}}

> {%
    client.test("레시피 목록 조회 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        client.assert(response.body.data.content.length > 0, "레시피가 1개 이상 존재해야 합니다.");
    });

    if (response.body && response.body.data && response.body.data.content && response.body.data.content.length > 0) {
        client.global.set("recipeId", response.body.data.content[0].recipeId);
        client.log("선택된 레시피 ID: " + response.body.data.content[0].recipeId);

        if (response.body.data.content.length > 1) {
            client.global.set("uncookedRecipeId", response.body.data.content[1].recipeId);
            client.log("요리 미완료 테스트용 레시피 ID: " + response.body.data.content[1].recipeId);
        } else {
            client.global.set("uncookedRecipeId", 999999);
        }
    }
%}

### 4-1. 시작 정리: 기존 내 후기 존재 여부 확인
GET http://localhost:8080/api/reviews?recipeId={{recipeId}}&mine=true
Cookie: access_token={{accessToken}}

> {%
    client.test("내 후기 목록 조회 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
    });

    if (response.body && response.body.data && response.body.data.content && response.body.data.content.length > 0) {
        client.global.set("existingReviewId", response.body.data.content[0].id);
    } else {
        client.global.set("existingReviewId", "0");
    }
%}

### 4-2. 시작 정리: 이전 실행에서 남은 후기 삭제 (없으면 404 허용)
DELETE http://localhost:8080/api/reviews/{{existingReviewId}}
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

> {%
    client.test("이전 후기 정리 (기존 후기 있으면 200, 없으면 404)", () => {
        client.assert(response.status === 200 || response.status === 404, "상태 코드는 200 또는 404여야 합니다.");
    });
%}

### 4-3. 요리 완료 기록 생성 (후기 작성 사전 조건)
POST http://localhost:8080/api/cooking-logs
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "recipeId": {{recipeId}},
  "result": "SUCCESS",
  "memo": "후기 작성을 위한 사전 요리 완료"
}

> {%
    client.test("사전 요리 완료 기록 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다. 현재: " + response.status);
    });
%}

### 4-4. 요리하지 않은 레시피 후기 작성 시 403 Forbidden 확인
POST http://localhost:8080/api/reviews
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "recipeId": {{uncookedRecipeId}},
  "rating": 5,
  "content": "요리하지 않은 레시피 후기 작성 시도"
}

> {%
    client.test("요리 미완료 레시피 후기 작성 실패 (403 Forbidden)", () => {
        client.assert(response.status === 403, "요리 기록이 없으면 403을 반환해야 합니다. 현재: " + response.status);
        if (response.body && response.body.error) {
            client.assert(response.body.error.code === "REVIEW_003", "에러 코드는 REVIEW_003이어야 합니다.");
        }
    });
%}

### 5. 레시피 후기 작성
POST http://localhost:8080/api/reviews
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "recipeId": {{recipeId}},
  "rating": 5,
  "content": "재료도 구하기 쉽고 정말 맛있게 먹었습니다! 추천합니다."
}

> {%
    client.test("후기 작성 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다. 현재: " + response.status);
        client.assert(response.body.data.id !== null, "생성된 후기 ID가 존재해야 합니다.");
    });

    if (response.status === 200 && response.body && response.body.data) {
        client.global.set("reviewId", response.body.data.id);
        client.log("생성된 후기 ID: " + response.body.data.id);
    }
%}

### 6. 같은 레시피 중복 작성 시 409 충돌 확인
POST http://localhost:8080/api/reviews
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "recipeId": {{recipeId}},
  "rating": 4,
  "content": "동일 레시피 중복 작성 실패 테스트"
}

> {%
    client.test("중복 작성 실패 (409 Conflict)", () => {
        client.assert(response.status === 409, "이미 후기를 남긴 레시피는 409를 반환해야 합니다.");
    });
%}

### 7-1. 레시피 후기 목록 조회 (recipeId로 조회)
GET http://localhost:8080/api/reviews?recipeId={{recipeId}}
Cookie: access_token={{accessToken}}

> {%
    client.test("레시피별 후기 목록 조회 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        client.assert(response.body.data.content.length >= 1, "작성한 후기가 포함되어야 합니다.");
    });
%}

### 7-2. 레시피 후기 목록 조회 (mine=true 내 후기 필터)
GET http://localhost:8080/api/reviews?recipeId={{recipeId}}&mine=true
Cookie: access_token={{accessToken}}

> {%
    client.test("내 후기 필터 조회 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        const allMine = response.body.data.content.every(r => r.mine === true);
        client.assert(allMine, "모든 후기의 mine 필드가 true여야 합니다.");
    });
%}

### 7-3. 레시피 후기 목록 조회 (별점순 정렬 sort=RATING)
GET http://localhost:8080/api/reviews?recipeId={{recipeId}}&sort=RATING
Cookie: access_token={{accessToken}}

> {%
    client.test("별점순 정렬 후기 목록 조회 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
    });
%}

### 8. 후기 수정 (별점 및 내용 변경)
PATCH http://localhost:8080/api/reviews/{{reviewId}}
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "rating": 4,
  "content": "간을 조금 약하게 하니 제 입맛에 딱 맞네요. 내용 수정합니다."
}

> {%
    client.test("후기 수정 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        client.assert(response.body.data.rating === 4, "별점이 4로 변경되어야 합니다.");
        client.assert(response.body.data.content === "간을 조금 약하게 하니 제 입맛에 딱 맞네요. 내용 수정합니다.", "내용이 수정되어야 합니다.");
    });
%}

### 9-1. 실패 검증: 별점 6 입력 시 400
PATCH http://localhost:8080/api/reviews/{{reviewId}}
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "rating": 6,
  "content": "별점 초과 테스트"
}

> {%
    client.test("별점 5 초과 시 400 반환 확인", () => {
        client.assert(response.status === 400, "별점이 5를 초과하면 400이어야 합니다.");
    });
%}

### 9-2. 실패 검증: 내용 101자 입력 시 400
PATCH http://localhost:8080/api/reviews/{{reviewId}}
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "rating": 5,
  "content": "12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901"
}

> {%
    client.test("내용 100자 초과 시 400 반환 확인", () => {
        client.assert(response.status === 400, "내용이 100자를 초과하면 400이어야 합니다.");
    });
%}

### 9-3. 실패 검증: 존재하지 않는 reviewId 수정 시 404
PATCH http://localhost:8080/api/reviews/9999999
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

{
  "rating": 3,
  "content": "존재하지 않는 후기 수정 테스트"
}

> {%
    client.test("없는 후기 수정 실패 (404)", () => {
        client.assert(response.status === 404, "존재하지 않는 후기 수정은 404여야 합니다.");
    });
%}

### 10. 후기 삭제
DELETE http://localhost:8080/api/reviews/{{reviewId}}
X-XSRF-TOKEN: {{csrfToken}}
Cookie: access_token={{accessToken}}; XSRF-TOKEN={{csrfToken}}

> {%
    client.test("후기 삭제 성공", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
    });
%}

### 11. 정리 확인: 삭제된 후기가 내 후기 목록에 없는지 조회 검증
GET http://localhost:8080/api/reviews?recipeId={{recipeId}}&mine=true
Cookie: access_token={{accessToken}}

> {%
    client.test("삭제 확인 - 내 후기 목록에 존재하지 않음", () => {
        client.assert(response.status === 200, "상태 코드는 200이어야 합니다.");
        const targetReviewId = parseInt(client.global.get("reviewId"));
        const exists = response.body.data.content.some(r => r.id === targetReviewId);
        client.assert(!exists, "삭제한 후기가 목록에 없어야 합니다.");
    });
%}
